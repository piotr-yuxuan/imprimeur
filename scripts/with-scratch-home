#!/usr/bin/env bash
# SPDX-License-Identifier: EUPL-1.2 OR GPL-3.0-or-later
#
# Usage: scripts/with-scratch-home COMMAND [ARGUMENT...]
#
# Run COMMAND with a fresh HOME, XDG directories and TMPDIR, so that no
# test reads or writes the user's own: no git configuration but the test
# identity, no Emacs load path from the session, no display.  The marker
# file .imprimeur-scratch in HOME tells tests/run-ert.el that it runs here.
# The scratch directory is deleted when COMMAND succeeds, and kept and
# printed when it fails.  It is always under /tmp, whatever TMPDIR holds:
# Chromium's SingletonSocket and WebKit's sockets go under it, and a Unix
# socket's path has at most 107 bytes.

set -uo pipefail

if (( $# == 0 )); then
  echo "usage: scripts/with-scratch-home COMMAND [ARGUMENT...]" >&2
  exit 2
fi

# An interactive Emacs ignores SIGPIPE, so a write to a process that has
# exited is an error it can handle. A batch Emacs keeps what it inherits,
# and would die of that write, so a test would see what no user can.
trap '' PIPE

scratch=$(TMPDIR=/tmp mktemp -d -t imprimeur-scratch.XXXXXX) || exit 2
mkdir -p "$scratch"/{home,config,cache,data,state,tmp}
touch "$scratch/home/.imprimeur-scratch"

env -u EMACSLOADPATH -u DISPLAY -u WAYLAND_DISPLAY \
  HOME="$scratch/home" \
  XDG_CONFIG_HOME="$scratch/config" \
  XDG_CACHE_HOME="$scratch/cache" \
  XDG_DATA_HOME="$scratch/data" \
  XDG_STATE_HOME="$scratch/state" \
  TMPDIR="$scratch/tmp" \
  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_CONFIG_NOSYSTEM=1 \
  GIT_AUTHOR_NAME=tests GIT_AUTHOR_EMAIL=tests@example.invalid \
  GIT_COMMITTER_NAME=tests GIT_COMMITTER_EMAIL=tests@example.invalid \
  "$@"
status=$?

if (( status == 0 )); then
  rm -rf -- "$scratch"
else
  echo "with-scratch-home: kept $scratch" >&2
fi
exit "$status"
