#!/usr/bin/env bash
# SPDX-License-Identifier: EUPL-1.2 OR GPL-3.0-or-later
#
# Usage: tests/run-node DIRECTORY
#
# Run every *.test.mjs file under DIRECTORY with node's test runner, one
# file at a time, and fail unless each file ran at least one test and every
# test ran and passed.  So the run fails when there is no such file, when a
# file defines no test (node then reports the file itself as a passing
# test, or counts no test for an empty suite), and when a test or a suite
# is skipped or left to do (node's counts miss a skipped suite, so the
# directives are read on each result line).

set -uo pipefail

if (( $# != 1 )); then
  echo "usage: tests/run-node DIRECTORY" >&2
  exit 2
fi

mapfile -d '' files < <(find "$1" -type f -name '*.test.mjs' -print0 | sort -z)
if (( ${#files[@]} == 0 )); then
  echo "run-node: no *.test.mjs file under $1" >&2
  exit 1
fi

status=0
for file in "${files[@]}"; do
  output=$(node --test --test-reporter=tap "$file" 2>&1)
  rc=$?
  printf '%s\n' "$output"
  if (( rc != 0 )); then
    echo "run-node: $file: a test failed" >&2
    status=1
  elif grep -qE '^[[:space:]]*(not )?ok [0-9]+ - .* # (SKIP|TODO)' <<<"$output"; then
    echo "run-node: $file: a test or a suite is skipped or left to do" >&2
    status=1
  elif grep -qE '^# tests 0$|^ok [0-9]+ - .*\.test\.mjs$' <<<"$output"; then
    echo "run-node: $file: defines no test" >&2
    status=1
  fi
done
exit "$status"
